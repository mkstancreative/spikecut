# ── Browser-safe (bundled into the frontend) ────────────────────────────
VITE_SUPABASE_URL=https://wmakdyhkihmfssutqebz.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_…) or legacy "anon" key
VITE_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated currencies your Paystack account can charge: NGN, GHS, USD
VITE_BILLING_CURRENCIES=NGN

# ── Server-only secrets (never prefix with VITE_) ───────────────────────
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_…) or legacy "service_role" key
SUPABASE_SECRET_KEY=
# Paystack → Settings → API Keys & Webhooks → Test Secret Key (sk_test_…)
PAYSTACK_SECRET_KEY=
# Where Paystack sends users back after checkout
APP_URL=https://localhost:5180

# ── Phase 3: creator monitoring (server-only) ───────────────────────────
# Twitch → dev.twitch.tv/console → Register Your Application
#   Category: Website Integration · OAuth Redirect URL: http://localhost:5180
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → Create API key
YOUTUBE_API_KEY=

# ── Phase 5: publishing (server-only) ───────────────────────────────────
# YouTube posting: Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorized redirect URI: https://localhost:5180/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Instagram + Facebook posting: developers.facebook.com → My Apps → Create app (Business)
#   Facebook Login for Business → Valid OAuth Redirect URI: https://localhost:5180/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Optional: Facebook Login for Business → Configurations → the config ID (used instead of a permission list)
META_LOGIN_CONFIG_ID=
# Encrypts stored social tokens. Generate: openssl rand -base64 32 (never change it once accounts are connected)
TOKEN_ENCRYPTION_KEY=
