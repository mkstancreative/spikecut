# ── Browser-safe (bundled into the frontend) ────────────────────────────
VITE_SUPABASE_URL=https://wmakdyhkihmfssutqebz.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_…) or legacy "anon" key
VITE_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated currencies your Paystack account can charge: NGN, GHS, USD
VITE_BILLING_CURRENCIES=NGN

# ── Server-only secrets (never prefix with VITE_) ───────────────────────
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_…) or legacy "service_role" key
SUPABASE_SECRET_KEY=
# Paystack → Settings → API Keys & Webhooks → Test Secret Key (sk_test_…)
PAYSTACK_SECRET_KEY=
# Where Paystack sends users back after checkout
APP_URL=https://localhost:5180

# ── Phase 3: creator monitoring (server-only) ───────────────────────────
# Twitch → dev.twitch.tv/console → Register Your Application
#   Category: Website Integration · OAuth Redirect URL: http://localhost:5180
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → Create API key
YOUTUBE_API_KEY=

# ── Phase 5: publishing (server-only) ───────────────────────────────────
# YouTube posting: Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorized redirect URI: https://localhost:5180/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Instagram + Facebook posting: developers.facebook.com → My Apps → Create app (Business)
#   Facebook Login for Business → Valid OAuth Redirect URI: https://localhost:5180/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Optional: Facebook Login for Business → Configurations → the config ID (used instead of a permission list)
META_LOGIN_CONFIG_ID=
# TikTok posting: developers.tiktok.com → Manage apps → add Login Kit + Content Posting API (Direct Post on)
#   Login Kit → Redirect URI: https://localhost:5180/api/oauth/tiktok/callback · scopes user.info.basic, video.publish
#   Until TikTok audits the app, posts can only be private ("Only me").
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Animate: cartoon styles (server-only) ──────────────────────────────
# AI styles (3D animated, anime, claymation, comic) use fal.ai Lucy Restyle — about $0.01 per second of video.
#   fal.ai → Dashboard → Keys. Leave empty and only the free Light filter is offered.
FAL_KEY=
# The free Light filter runs DCT-Net locally: bash workers/py/setup_light_filter.sh (defaults to .models/dctnet/3d)
LIGHT_FILTER_MODELS=
# Encrypts stored social tokens. Generate: openssl rand -base64 32 (never change it once accounts are connected)
TOKEN_ENCRYPTION_KEY=

# ── Clip pipeline: yt-dlp auth (server-only) ────────────────────────────
# YouTube may reply "Sign in to confirm you're not a bot". Set ONE of these:
#   a browser where you're signed in to YouTube (chrome, safari, firefox, brave, edge…) — easiest locally
YTDLP_COOKIES_FROM_BROWSER=
#   or a Netscape-format cookies.txt export — use this on servers
YTDLP_COOKIES=

# ── Clip pipeline: moment picking (server-only) ─────────────────────────
# Claude reads each transcript and picks the clips. Without a key, an audio/keyword heuristic is used.
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5); CLIP_AI=off forces the heuristic
CLIP_AI_MODEL=
# Speech models (defaults: .models/ggml-large-v3-turbo-q5_0.bin, falling back to base.en; Silero VAD)
#   curl -L -o .models/ggml-large-v3-turbo-q5_0.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo-q5_0.bin
#   curl -L -o .models/ggml-silero-v5.1.2.bin https://huggingface.co/ggml-org/whisper-vad/resolve/main/ggml-silero-v5.1.2.bin
WHISPER_MODEL=
WHISPER_VAD_MODEL=
